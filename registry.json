{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "yanisneverlies-ui",
  "homepage": "https://github.com/yanisneverlies/ui",
  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Theme",
      "description": "Design tokens: warm neutrals, one primary, semantic tones, concentric radii, Inter and Apfel Grotezk. Import it after tailwindcss in your global CSS.",
      "dependencies": [
        "@fontsource-variable/inter",
        "@fontsource/apfel-grotezk"
      ],
      "files": [
        {
          "path": "src/styles/ui.css",
          "type": "registry:file",
          "target": "~/styles/ui.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "cn(): clsx plus tailwind-merge that knows the custom type scale.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "sound",
      "type": "registry:lib",
      "title": "Sound",
      "description": "Opt-in interaction sounds through cuelume. Off unless the app turns them on.",
      "dependencies": [
        "cuelume"
      ],
      "files": [
        {
          "path": "src/lib/sound.tsx",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Primary, secondary, tonal, ghost, destructive and link; three sizes plus icon sizes; render prop; pending state; optional sound.",
      "dependencies": [
        "@ui-sdk/react",
        "@ui-sdk/core",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "@yanisneverlies/theme",
        "@yanisneverlies/utils",
        "@yanisneverlies/sound"
      ],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
