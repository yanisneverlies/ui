  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Theme",
      "description": "Design tokens: warm neutrals, one primary, semantic tones, concentric radii, Inter and Apfel Grotezk. Import it after tailwindcss in your global CSS.",
      "dependencies": [
        "@fontsource-variable/inter",
        "@fontsource/apfel-grotezk"
      ],
      "files": [
        {
          "path": "src/styles/ui.css",
          "type": "registry:file",
          "target": "~/styles/ui.css"
        }
      ]
    },
